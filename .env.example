# Desktop OAuth application configuration. Copy to .env locally or inject the
# variables through CI at build time. Never commit populated credentials,
# tokens, refresh tokens, or app passwords.
VAULTMESH_GOOGLE_OAUTH_CLIENT_ID="your-desktop-client.apps.googleusercontent.com"
VAULTMESH_GOOGLE_OAUTH_CLIENT_SECRET="your-desktop-client-secret"
VAULTMESH_MICROSOFT_OAUTH_CLIENT_ID="00000000-0000-0000-0000-000000000000"
VAULTMESH_MICROSOFT_OAUTH_TENANT="common"
