<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="AppDataFolder">
        <Directory Id="VaultMeshAppDataFolder" Name="com.vaultmesh.desktop">
          <Component Id="BrowserNativeMessagingRegistration" Guid="*">
            <CreateFolder />
            <RegistryKey Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\com.vaultmesh.browser" Action="createAndRemoveOnUninstall">
              <RegistryValue Type="string" Value="[VaultMeshAppDataFolder]com.vaultmesh.browser.json" KeyPath="yes" />
            </RegistryKey>
            <RegistryKey Root="HKCU" Key="Software\Microsoft\Edge\NativeMessagingHosts\com.vaultmesh.browser" Action="createAndRemoveOnUninstall">
              <RegistryValue Type="string" Value="[VaultMeshAppDataFolder]com.vaultmesh.browser.json" />
            </RegistryKey>
            <RegistryKey Root="HKCU" Key="Software\Mozilla\NativeMessagingHosts\com.vaultmesh.browser" Action="createAndRemoveOnUninstall">
              <RegistryValue Type="string" Value="[VaultMeshAppDataFolder]com.vaultmesh.browser.firefox.json" />
            </RegistryKey>
            <RemoveFile Id="RemoveBrowserHostManifest" Name="com.vaultmesh.browser.json" On="uninstall" />
            <RemoveFile Id="RemoveFirefoxBrowserHostManifest" Name="com.vaultmesh.browser.firefox.json" On="uninstall" />
            <RemoveFile Id="RemoveBrowserHostConfig" Name="browser-host-config.json" On="uninstall" />
            <RemoveFolder Id="RemoveVaultMeshAppDataFolderIfEmpty" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </DirectoryRef>
  </Fragment>
</Wix>
